# Generated or vendored: `node infra/grafana/dashboards/build.mjs --check` compares these byte-for-byte,
# so prettier must not reformat them (and reformatting a generated file is how a
# "generated from source" file stops being reproducible).
infra/grafana/dashboards/*.json
loadtests/results/
package-lock.json

# k6 scripts are generated by tools/loadgen --emit-k6 from the JSON configs;
# CI regenerates and diffs them, so prettier must not touch them either.
loadtests/smoke.js
loadtests/load.js
loadtests/tenant-isolation.js
