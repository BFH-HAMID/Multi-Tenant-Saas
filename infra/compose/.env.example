# Copy to `.env` in this directory (`cp .env.example .env`) and change the secrets.
# Nothing in this file is safe for a real deployment — but the *shape* is what matters:
# every one of these is read by the same env schema the containers use, so a value that
# boots here is a value that boots in Kubernetes.

# Postgres superuser, used only by the one-shot `migrate` service. The API/worker connect
# as app_user, which has no DDL rights and no BYPASSRLS.
POSTGRES_PASSWORD=lab-postgres-password

# Password for the least-privilege runtime role. `db/dist/cli.js migrate` creates/updates
# the role with this value (dev/CI convenience — in production the role and its password
# are provisioned out of band, by the platform team or a Secret).
APP_USER_PASSWORD=lab-app-user-password

# HS256 signing key. 32 random bytes minimum; the config schema rejects <16 chars so a
# copy-paste placeholder fails loudly at boot instead of shipping a guessable token.
JWT_SECRET=replace-me-with-openssl-rand-base64-48-then-delete

# Protects the worker's /dlq and /dlq/replay admin endpoints (and the API's internal
# endpoints, if any). Different from JWT_SECRET on purpose: leaking the ops secret must
# not let an attacker mint access tokens.
INTERNAL_SECRET=replace-me-too-openssl-rand-base64-32

GRAFANA_PASSWORD=admin

# Baked into the `app_info` metric so a dashboard can answer "which build is this pod?".
BUILD_SHA=local
BUILD_VERSION=0.0.0-local
