        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres pool",
      "description": "Sustained `waiting` > 0 means the pool is the bottleneck, not Postgres. PG_POOL_MAX × api replicas must stay under max_connections, and this is the panel that proves it.",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_pool_connections)",
          "legendFormat": "{{state}}",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
