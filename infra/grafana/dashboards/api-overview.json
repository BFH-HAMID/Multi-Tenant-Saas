      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cache p95 vs request p95",
      "description": "The cache paying for itself, as one panel: the gap between these two lines is the time spent in Postgres and rendering. A flat request line at 0 is not \"cache disabled\" — it means the cache layer was never consulted for that route.",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cache_operation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "cache p95",
          "interval": ""
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "request p95",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
