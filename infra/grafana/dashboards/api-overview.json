            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cache: hit ratio by entity",
      "description": "`coalesced` counts as a win — it means concurrent readers shared one fill. Below ~50% this layer is not earning its complexity.",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (entity) (rate(cache_lookups_total{outcome=~\"hit|coalesced\"}[$__rate_interval])) / clamp_min(sum by (entity) (rate(cache_lookups_total[$__rate_interval])), 0.001)",
          "legendFormat": "{{entity}}",
          "interval": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
